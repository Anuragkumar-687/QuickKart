generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core commerce
// ---------------------------------------------------------------------------

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String @unique
  password String
  role     String @default("user") // "user" | "admin"

  // Region / address (Phase 2 — region-aware commerce)
  state   String?
  city    String?
  pincode String?
  region  String? // derived: North | South | East | West | Northeast

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  cart     Cart?
  reviews  Review[]
  wishlist WishlistItem[]
  views    ProductView[]

  @@index([region])
}

model Product {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float
  category    String
  image       String
  stock       Int    @default(0)

  // Normalized catalog fields (Phase 1 — API ingestion)
  rating      Float   @default(0)
  ratingCount Int     @default(0)
  brand       String?
  source      String  @default("seed") // dummyjson | fakestore | seed | manual
  externalId  String  @unique @default(cuid()) // "<source>-<apiId>" for ingested items

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  views        ProductView[]

  @@index([category])
  @@index([rating])
  @@index([source])
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  cartId        String  @db.ObjectId
  cart          Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String  @db.ObjectId
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int     @default(1)
  savedForLater Boolean @default(false) // Save For Later lives inside the cart

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  totalAmount Float
  status      String      @default("pending") // pending | processing | shipped | delivered | cancelled
  region      String? // snapshot of buyer region at purchase time
  createdAt   DateTime    @default(now())

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Reviews & Wishlist (Phase 1)
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId]) // one review per user per product
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Analytics events (Phase 2 — tracking pipeline)
// ---------------------------------------------------------------------------

model ProductView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  region    String?
  type      String   @default("view") // view | click
  createdAt DateTime @default(now())

  @@index([productId, region])
  @@index([userId, createdAt])
  @@index([region, type, createdAt])
}

model CartEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  productId String   @db.ObjectId
  region    String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([productId, region])
  @@index([region, createdAt])
}

model PurchaseEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  productId String   @db.ObjectId
  region    String?
  state     String?
  category  String?
  quantity  Int      @default(1)
  price     Float    @default(0)
  createdAt DateTime @default(now())

  @@index([productId, region])
  @@index([region, createdAt])
  @@index([state])
  @@index([category])
}

// Durable per-region rankings (recomputed by the trending engine)
model RegionAnalytics {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  region        String
  productId     String   @db.ObjectId
  views         Int      @default(0)
  clicks        Int      @default(0)
  cartAdds      Int      @default(0)
  purchases     Int      @default(0)
  trendingScore Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([region, productId])
  @@index([region, trendingScore])
}
