# ----------------------------------------------------------------------------
# QuickKart backend environment
# Copy to `.env` and fill in real values.
# ----------------------------------------------------------------------------

# MongoDB Atlas connection string (Prisma datasource)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/quickkart?retryWrites=true&w=majority"

# JWT signing — REQUIRED. Use a long random string in production.
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Redis (OPTIONAL). Leave empty to run without caching (the app degrades gracefully).
# Used for: trending products, regional rankings, recommendation results, hot product queries.
REDIS_URL=

# Background cron jobs (product ingestion refresh + trending recompute).
# Set to "true" to enable scheduled jobs.
ENABLE_CRON=false
